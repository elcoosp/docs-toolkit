{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 110,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "arrowParens": "always",
  "ignorePatterns": ["dist/**", "node_modules/**", "pnpm-lock.yaml", "src/assets/font-b64.ts"]
}

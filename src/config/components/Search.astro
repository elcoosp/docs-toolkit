---
import { getCollection } from 'astro:content';
import { AI_PROVIDERS } from './ai-providers';
import './search.css';

const t = Astro.locals.t;
const currentLocale = Astro.currentLocale;
const hasLocalePrefix = Boolean(currentLocale && (Astro.url.pathname === `/${currentLocale}` || Astro.url.pathname.startsWith(`/${currentLocale}/`)));
const localePrefix = hasLocalePrefix ? `/${currentLocale}` : '';
const isFr = currentLocale === 'fr';

const ui = {
  button: t('cmdk.button'),
  ariaLabel: t('cmdk.ariaLabel'),
  placeholder: t('cmdk.placeholder'),
  clear: t('cmdk.clear'),
  nav: t('cmdk.nav'),
  open: t('cmdk.open'),
  newTab: t('cmdk.newTab'),
  copy: t('cmdk.copy'),
  pin: t('cmdk.pin'),
  filter: t('cmdk.filter'),
  close: t('cmdk.close'),
  onThisPage: t('tableOfContents.onThisPage'),
  overview: t('tableOfContents.overview'),
  changelog: t('cmdk.changelog'),
  actionZen: t('cmdk.actionZen'),
  actionZenDesc: t('cmdk.actionZenDesc'),
  actionTheme: t('cmdk.actionTheme'),
  actionThemeDesc: t('cmdk.actionThemeDesc'),
  actionChangelog: t('cmdk.actionChangelog'),
  actionChangelogDesc: t('cmdk.actionChangelogDesc'),
  actionCopyMd: t('cmdk.actionCopyMd'),
  actionCopyMdDesc: t('cmdk.actionCopyMdDesc'),
  actionLangSwitch: t('cmdk.actionLangSwitch'),
  actionLangSwitchDesc: t('cmdk.actionLangSwitchDesc'),
  actionAskAi: t('cmdk.actionAskAi'),
  actionAskAiDesc: t('cmdk.actionAskAiDesc'),
  groupWorkspace: t('cmdk.groupWorkspace'),
  groupLanguage: t('cmdk.groupLanguage'),
  groupAi: t('cmdk.groupAi'),
  moreAi: t('cmdk.moreAi'),
  lessAi: t('cmdk.lessAi'),
  'cmdk.actionZen': t('cmdk.actionZen'),
  'cmdk.actionZenDesc': t('cmdk.actionZenDesc'),
  'cmdk.actionTheme': t('cmdk.actionTheme'),
  'cmdk.actionThemeDesc': t('cmdk.actionThemeDesc'),
  'cmdk.actionChangelog': t('cmdk.actionChangelog'),
  'cmdk.actionChangelogDesc': t('cmdk.actionChangelogDesc'),
  'cmdk.actionCopyMd': t('cmdk.actionCopyMd'),
  'cmdk.actionCopyMdDesc': t('cmdk.actionCopyMdDesc'),
  'cmdk.actionLangSwitch': t('cmdk.actionLangSwitch'),
  'cmdk.actionLangSwitchDesc': t('cmdk.actionLangSwitchDesc'),
  'cmdk.actionAskAi': t('cmdk.actionAskAi'),
  'cmdk.actionAskAiDesc': t('cmdk.actionAskAiDesc'),
  'cmdk.groupWorkspace': t('cmdk.groupWorkspace'),
  'cmdk.groupLanguage': t('cmdk.groupLanguage'),
  'cmdk.groupAi': t('cmdk.groupAi'),
  'cmdk.moreAi': t('cmdk.moreAi'),
  'cmdk.lessAi': t('cmdk.lessAi'),
  'cmdk.graphConnections': t('cmdk.graphConnections'),
};

const allDocs = await getCollection('docs').catch(() => []);
const knownNonRootLocales = new Set(
  allDocs
    .map((e) => e.id.split('/')[0])
    .filter((seg) => /^[a-z]{2}(?:-[a-z]{2})?$/i.test(seg) && seg !== currentLocale),
);

const sectionOrder: Record<string, number> = {
  tutorials: 1,
  guides: 2,
  reference: 3,
  explanation: 4,
  blog: 5,
  changelog: 6,
};

const sitePages = allDocs
  .filter((entry) => {
    if (entry.data?.draft) return false;
    const id = entry.id.replace(/\.(md|mdx)$/, '');
    if (hasLocalePrefix) {
      if (id !== currentLocale && !id.startsWith(`${currentLocale}/`)) return false;
    } else {
      const firstSeg = id.split('/')[0];
      if (knownNonRootLocales.has(firstSeg)) return false;
    }
    const stripped = hasLocalePrefix ? id.replace(new RegExp(`^${currentLocale}/?`), '') : id;
    return stripped !== '' && stripped !== 'index';
  })
  .map((entry) => {
    const cleanId = entry.id.replace(/\.(md|mdx)$/, '').replace(/(^|\/)index$/, '');
    const url = '/' + (cleanId ? cleanId + '/' : '');
    const stripped = hasLocalePrefix ? cleanId.replace(new RegExp(`^${currentLocale}/?`), '') : cleanId;
    const topSeg = stripped.split('/').at(0) || 'docs';
    const title = typeof entry.data?.title === 'string' && entry.data.title.trim() ? entry.data.title.trim() : topSeg;
    const body = typeof entry.body === 'string' ? entry.body : '';
    const headings = Array.from(body.matchAll(/^#{2,3}\s+(.+)$/gm))
      .map((m) => {
        const raw = (m.at(1) ?? '').replace(/[`*_]/g, '').replace(/\s*\{#[^}]+\}\s*$/, '').trim();
        const slug = raw
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, '');
        return { title: raw, slug };
      })
      .filter((h) => h.title && h.slug);
    return { title, url, headings, order: sectionOrder[topSeg] ?? 9 };
  })
  .sort((a, b) => a.order - b.order || a.title.localeCompare(b.title))
  .map(({ title, url, headings }) => ({ title, url, headings }));

const changelogEntries = await getCollection('changelogs').catch(() => []);
const validReleases = changelogEntries
  .filter((e: any) => e?.data?.base === 'changelog' && e?.data?.slug)
  .sort((a: any, b: any) => {
    const da = a?.data?.date ? new Date(a.data.date).getTime() : 0;
    const db = b?.data?.date ? new Date(b.data.date).getTime() : 0;
    return db - da;
  });
if (validReleases.length > 0) {
  sitePages.push({
    title: ui.changelog,
    url: `${localePrefix}/changelog/`,
    headings: [],
  });
  for (const rel of validReleases) {
    const d = rel.data;
    const rawVer = String(d.version || d.title || d.slug).replace(/^[\[v]+|\]+$/g, '').trim();
    const verLabel = /^\d/.test(rawVer) ? `v${rawVer}` : rawVer;
    const dateStr = d.date
      ? new Date(d.date).toLocaleDateString(currentLocale || 'en', { year: 'numeric', month: 'short', day: 'numeric' })
      : '';
    sitePages.push({
      title: dateStr ? `${verLabel} — ${dateStr}` : verLabel,
      url: `${localePrefix}/changelog/version/${d.slug}/`,
      headings: [],
    });
  }
}

const cmdkConfig = {
  locale: currentLocale || 'en',
  localePrefix,
  ui,
  aiProviders: AI_PROVIDERS.map(({ id, name, tag, labels, pathname, param, extra, path }) => ({
    id,
    name,
    tag,
    labels,
    pathname,
    param,
    extra,
    path,
  })),
};
---

<div class="sl-cmdk-root" data-cmdk-root data-locale={isFr ? 'fr' : 'en'}>
  <script type="application/json" data-cmdk-pages set:html={JSON.stringify(sitePages)} />
  <script type="application/json" data-cmdk-config set:html={JSON.stringify(cmdkConfig)} />
  <button type="button" class="sl-cmdk-trigger" data-cmdk-open aria-label={ui.ariaLabel}>
    <span class="sl-cmdk-trigger__left">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <span class="sl-cmdk-trigger__label">{ui.button}</span>
    </span>
    <kbd class="sl-cmdk-trigger__kbd" data-cmdk-shortcut>⌘K</kbd>
  </button>

  <dialog id="sl-cmdk-dialog" class="sl-cmdk-dialog" aria-label={ui.ariaLabel}>
    <div class="sl-cmdk-shell">
      <div class="sl-cmdk-panel">
        <div class="sl-cmdk-header">
          <svg class="sl-cmdk-header__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8" />
            <path d="m21 21-4.3-4.3" />
          </svg>
          <span id="sl-cmdk-mode-pill" class="sl-cmdk-mode-pill" hidden></span>
          <input
            id="sl-cmdk-input" aria-controls="sl-cmdk-list"
            class="sl-cmdk-input"
            type="search"
            autocomplete="off"
            spellcheck="false"
            placeholder={ui.placeholder}
          />
          <button id="sl-cmdk-clear" type="button" class="sl-cmdk-clear" data-visible="false" tabindex="-1" aria-hidden="true">{ui.clear}</button>
        </div>

        <div id="sl-cmdk-tabs" class="sl-cmdk-tabs" role="group" hidden></div>

        <div class="sl-cmdk-body">
          <div id="sl-cmdk-list" class="sl-cmdk-list" role="listbox"></div>
          <aside id="sl-cmdk-preview" class="sl-cmdk-preview" aria-live="polite"></aside>
        </div>

        <div class="sl-cmdk-footer">
          <div id="sl-cmdk-hints" class="sl-cmdk-hints">
            <span class="sl-cmdk-hint"><kbd class="sl-cmdk-kbd">↑↓</kbd> {ui.nav}</span>
            <span class="sl-cmdk-hint"><kbd class="sl-cmdk-kbd">↵</kbd> {ui.open}</span>
            <span class="sl-cmdk-hint"><kbd class="sl-cmdk-kbd" data-cmdk-pin-kbd>⌘D</kbd> {ui.pin}</span>
            <span class="sl-cmdk-hint"><kbd class="sl-cmdk-kbd">ESC</kbd> {ui.close}</span>
          </div>
          <div class="sl-cmdk-footer__right">
            <div class="sl-cmdk-shortcuts-wrap">
              <button id="sl-cmdk-shortcuts-btn" type="button" class="sl-cmdk-shortcuts-btn" aria-expanded="false" aria-controls="sl-cmdk-shortcuts-popover">
                <kbd class="sl-cmdk-kbd">?</kbd>
                <span>{isFr ? "Raccourcis" : "Shortcuts"}</span>
              </button>
              <div id="sl-cmdk-shortcuts-popover" class="sl-cmdk-shortcuts-popover" hidden>
                <div class="sl-cmdk-shortcuts-popover__title">{isFr ? "Raccourcis clavier" : "Keyboard shortcuts"}</div>
                <div class="sl-cmdk-shortcuts-popover__grid">
                  <span>{ui.nav}</span><kbd class="sl-cmdk-kbd">↑↓ / ⌃N ⌃P</kbd>
                  <span>{ui.open}</span><kbd class="sl-cmdk-kbd">↵</kbd>
                  <span>{ui.newTab}</span><kbd class="sl-cmdk-kbd" data-cmdk-newtab-kbd>⌘↵</kbd>
                  <span>{ui.copy}</span><kbd class="sl-cmdk-kbd" data-cmdk-copy-kbd>⌘C</kbd>
                  <span>{isFr ? "Copier en Markdown" : "Copy Markdown"}</span><kbd class="sl-cmdk-kbd">⌘⇧C</kbd>
                  <span>{ui.pin}</span><kbd class="sl-cmdk-kbd" data-cmdk-pin-kbd>⌘D</kbd>
                  <span>{isFr ? "Marquer la sélection" : "Mark selection"}</span><kbd class="sl-cmdk-kbd">⌘M</kbd>
                  <span>{ui.filter}</span><kbd class="sl-cmdk-kbd">Tab</kbd>
                  <span>{isFr ? "Historique" : "History"}</span><kbd class="sl-cmdk-kbd">⌥P / ⌥N</kbd>
                  <span>{isFr ? "Modes rapides" : "Quick modes"}</span><span class="sl-cmdk-mode-triggers"><button type="button" class="sl-cmdk-kbd sl-cmdk-mode-trigger" data-cmdk-trigger="/">/</button><button type="button" class="sl-cmdk-kbd sl-cmdk-mode-trigger" data-cmdk-trigger="#">#</button><button type="button" class="sl-cmdk-kbd sl-cmdk-mode-trigger" data-cmdk-trigger="ref:">ref:</button><button type="button" class="sl-cmdk-kbd sl-cmdk-mode-trigger" data-cmdk-trigger="log:">log:</button></span>
                </div>
              </div>
            </div>
            <span id="sl-cmdk-status" class="sl-cmdk-status"></span>
          </div>
        </div>
      </div>
    </div>
  </dialog>
</div>

<script>
  import './search-client.ts';
</script>

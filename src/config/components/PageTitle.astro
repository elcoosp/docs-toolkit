---
import DefaultPageTitle from "@astrojs/starlight/components/PageTitle.astro";
import ReadingContextBar from "../../plugins/reading-context/ReadingContextBar.astro";
import PageActions from "./PageActions.astro";

const p = Astro.url.pathname.replace(/\/$/, "") || "/";
const is404 = Astro.props.id === "404" || p.endsWith("/404");
const isGeneratedIndex =
  p === "/blog" ||
  p === "/fr/blog" ||
  p.includes("/blog/authors/") ||
  p.includes("/blog/tags/") ||
  p === "/changelog" ||
  p === "/fr/changelog" ||
  p.includes("/changelog/version/");
const showPageTools = !is404 && !isGeneratedIndex;
---

<DefaultPageTitle {...Astro.props} />
{showPageTools && <ReadingContextBar />}
{showPageTools && <PageActions {...Astro.props} />}

<script>
  import "./zen-mode-client.ts";
</script>

<style>
  :global(html[data-zen-mode="true"] header.header),
  :global(html[data-zen-mode="true"] nav.sidebar),
  :global(html[data-zen-mode="true"] .right-sidebar-container),
  :global(html[data-zen-mode="true"] starlight-toc),
  :global(html[data-zen-mode="true"] mobile-starlight-toc) {
    display: none !important;
  }
  :global(html[data-zen-mode="true"] .main-frame) {
    padding-top: 1.5rem !important;
    padding-inline-start: 0 !important;
  }
  :global(html[data-zen-mode="true"] .main-pane) {
    max-width: 56rem;
    margin-inline: auto;
  }
</style>

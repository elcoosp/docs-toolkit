---
type Props = Record<string, any>;
import { AI_PROVIDERS, buildAiProviderHref } from './ai-providers';

const { editUrl } = Astro.props;
const t = Astro.locals.t;
const pagePath = Astro.url.pathname;
const pageUrl = Astro.site ? new URL(pagePath, Astro.site).toString() : pagePath;

const aiProviders = AI_PROVIDERS.map((p) => ({
  name: p.name,
  tag: p.tag,
  href: buildAiProviderHref(p, pageUrl),
  path: p.path,
}));

const labels = {
  copy: t('pageActions.copy'),
  copyTitle: t('pageActions.copyTitle'),
  copied: t('pageActions.copied'),
  copyError: t('pageActions.copyError'),
  openAi: t('pageActions.openAi'),
  aiHeader: t('pageActions.aiHeader'),
  share: t('pageActions.share'),
  shareTitle: t('pageActions.shareTitle'),
  linkCopied: t('pageActions.linkCopied'),
  source: t('pageActions.source'),
  sourceTitle: t('pageActions.sourceTitle'),
};
---

<div
  class="page-actions-container not-content" data-pagefind-ignore="all"
  data-copy-label={labels.copy}
  data-copied-label={labels.copied}
  data-copy-error={labels.copyError}
  data-share-label={labels.share}
  data-link-copied={labels.linkCopied}
>
  <button id="copy-markdown" type="button" class="action-btn action-btn--morph" title={labels.copyTitle}>
    <span class="morph-icon" aria-hidden="true">
      <svg class="morph-icon__base" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="morph-icon__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 12.75l5.25 5.25L19.5 7.5" />
      </svg>
    </span>
    <span class="morph-label"><span class="morph-label__default">{labels.copy}</span><span class="morph-label__success" aria-hidden="true">{labels.copied}</span></span>
  </button>

  <div class="action-dropdown" data-open="false">
    <button id="open-ai-trigger" type="button" class="action-btn" aria-haspopup="menu" aria-expanded="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 8V4H8" />
        <rect width="16" height="12" x="4" y="8" rx="2" />
        <path d="M2 14h2" />
        <path d="M20 14h2" />
        <path d="M15 13v2" />
        <path d="M9 13v2" />
      </svg>
      <span>{labels.openAi}</span>
      <svg class="ai-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
    <div class="dropdown-bridge">
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-menu__header">
          <span>{labels.aiHeader}</span>
        </div>
        <div class="dropdown-menu__grid">
          {aiProviders.map((provider) => (
            <a class="ai-card" role="menuitem" href={provider.href} target="_blank" rel="noopener">
              <span class="ai-card__icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={provider.path} />
                </svg>
              </span>
              <span class="ai-card__text">
                <span class="ai-card__name">{provider.name}</span>
                <span class="ai-card__tag">{provider.tag}</span>
              </span>
              <svg class="ai-card__arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <button id="share-page" type="button" class="action-btn action-btn--morph" title={labels.shareTitle}>
    <span class="morph-icon" aria-hidden="true">
      <svg class="morph-icon__base" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
        <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />
      </svg>
      <svg class="morph-icon__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 12.75l5.25 5.25L19.5 7.5" />
      </svg>
    </span>
    <span class="morph-label"><span class="morph-label__default">{labels.share}</span><span class="morph-label__success" aria-hidden="true">{labels.linkCopied}</span></span>
  </button>

  {editUrl && (
    <a href={editUrl} target="_blank" rel="noopener" class="action-btn" title={labels.sourceTitle}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
        <path d="m15 5 4 4" />
      </svg>
      <span>{labels.source}</span>
    </a>
  )}
  <button
    type="button"
    class="action-btn sl-zen-toggle"
    data-zen-toggle
    aria-pressed="false"
    title="Toggle Zen Mode (Alt+Z)"
  >
    <span class="sl-zen-icon" aria-hidden="true">
      <svg class="sl-zen-icon--expand" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M8 3H5a2 2 0 0 0-2 2v3m18 0V5a2 2 0 0 0-2-2h-3m0 18h3a2 2 0 0 0 2-2v-3M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
      <svg class="sl-zen-icon--compress" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 14h6v6M20 10h-6V4M14 10l7-7M3 21l7-7" />
      </svg>
    </span>
    <span class="sl-zen-label">Zen</span>
    <span class="sl-zen-dot" aria-hidden="true"></span>
  </button>
</div>

<script>
  import './page-actions-client.ts';
</script>

<style>
  .page-actions-container {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .action-btn {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    padding: 0.34rem 0.72rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }
  .action-btn:hover,
  .action-btn:focus-visible {
    background: var(--sl-color-bg-sidebar);
    border-color: var(--sl-color-accent);
  }
  .action-btn:active {
    transform: scale(0.97);
  }
  .action-btn[data-state='success'] {
    border-color: color-mix(in srgb, #10b981 55%, var(--sl-color-hairline));
    background: color-mix(in srgb, #10b981 12%, var(--sl-color-bg-nav));
    color: #059669;
  }
  :root[data-theme='dark'] .action-btn[data-state='success'] {
    color: #34d399;
  }
  .morph-icon {
    position: relative;
    display: inline-flex;
align-items: center;
justify-content: center;
width: 15px;
height: 15px;
flex-shrink: 0;
}
.morph-icon__base,
.morph-icon__check {
position: absolute;
inset: 0;
transform-origin: center;
}
.morph-icon__check {
opacity: 0;
transform: scale(0.5);
}
.morph-label {
display: inline-grid;
align-items: center;
}
.morph-label__default,
.morph-label__success {
grid-area: 1 / 1;
transition: opacity 150ms ease;
}
.morph-label__success {
opacity: 0;
}
.action-btn[data-state='success'] .morph-label__default {
opacity: 0;
}
.action-btn[data-state='success'] .morph-label__success {
opacity: 1;
}
.action-dropdown {
position: relative;
display: inline-block;
}
.action-dropdown[data-open='true'] > .action-btn {
border-color: var(--sl-color-accent);
background: var(--sl-color-bg-sidebar);
}
.dropdown-bridge {
display: none;
position: absolute;
top: 100%;
left: 0;
padding-top: 0.35rem;
z-index: 40;
}
.action-dropdown[data-open='true'] .dropdown-bridge {
display: block;
}
.dropdown-menu {
width: min(372px, calc(100vw - 2rem));
padding: 0.55rem;
background: var(--sl-color-bg-nav);
border: 1px solid var(--sl-color-hairline);
border-radius: 0.75rem;
box-shadow:
0 18px 40px -10px rgba(0, 0, 0, 0.28),
0 4px 12px -2px rgba(0, 0, 0, 0.12);
transform-origin: top left;
}
:root[data-theme='dark'] .dropdown-menu {
box-shadow:
0 20px 44px -10px rgba(0, 0, 0, 0.62),
0 4px 14px -2px rgba(0, 0, 0, 0.35);
}
.dropdown-menu__header {
padding: 0.15rem 0.35rem 0.45rem;
font-size: 0.7rem;
font-weight: 600;
letter-spacing: 0.03em;
text-transform: uppercase;
color: var(--sl-color-gray-3);
}
.dropdown-menu__grid {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 0.3rem;
}
@media (max-width: 420px) {
.dropdown-menu__grid {
grid-template-columns: 1fr;
}
}
.ai-card {
display: flex;
align-items: center;
gap: 0.5rem;
padding: 0.42rem 0.5rem;
border-radius: 0.5rem;
border: 1px solid transparent;
text-decoration: none;
color: var(--sl-color-text);
transition: background-color 140ms ease, border-color 140ms ease;
}
.ai-card:hover,
.ai-card:focus-visible {
background: var(--sl-color-bg-sidebar);
border-color: color-mix(in srgb, var(--sl-color-accent) 42%, transparent);
outline: none;
}
.ai-card__icon {
display: inline-flex;
align-items: center;
justify-content: center;
width: 26px;
height: 26px;
border-radius: 0.42rem;
background: var(--sl-color-bg-inline-code, rgba(128, 128, 128, 0.1));
border: 1px solid var(--sl-color-hairline-light, rgba(128, 128, 128, 0.18));
color: var(--sl-color-text);
flex-shrink: 0;
transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
}
.ai-card:hover .ai-card__icon {
background: var(--sl-color-accent-low);
border-color: color-mix(in srgb, var(--sl-color-accent) 36%, transparent);
color: var(--sl-color-accent-high);
}
.ai-card__text {
display: flex;
flex-direction: column;
min-width: 0;
flex: 1;
line-height: 1.2;
}
.ai-card__name {
font-size: 0.79rem;
font-weight: 600;
color: var(--sl-color-text);
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
}
.ai-card__tag {
font-size: 0.67rem;
color: var(--sl-color-gray-3);
margin-top: 0.1rem;
}
.ai-card__arrow {
opacity: 0;
color: var(--sl-color-accent-high);
flex-shrink: 0;
transform: translate(-3px, 3px);
transition: opacity 140ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}
.ai-card:hover .ai-card__arrow,
.ai-card:focus-visible .ai-card__arrow {
opacity: 0.9;
transform: translate(0, 0);
}
  .sl-zen-toggle {
    margin-inline-start: auto;
  }
  @media (max-width: 560px) {
    .page-actions-container {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.45rem;
    }
    .page-actions-container > .action-btn,
    .page-actions-container > .action-dropdown,
    .page-actions-container > .action-dropdown > .action-btn {
      width: 100%;
      justify-content: center;
    }
    .sl-zen-toggle {
      margin-inline-start: 0;
    }
    .sl-zen-toggle:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
    .dropdown-bridge {
      left: auto;
      right: 0;
    }
  }
  :global(html[data-zen-mode="true"]) .sl-zen-toggle {
    color: var(--sl-color-accent-high);
    border-color: color-mix(in srgb, var(--sl-color-accent) 60%, var(--sl-color-hairline));
    background: color-mix(in srgb, var(--sl-color-accent) 14%, var(--sl-color-bg-nav));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sl-color-accent) 12%, transparent);
  }
  .sl-zen-icon {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 15px;
    height: 15px;
    flex-shrink: 0;
  }
  .sl-zen-icon--expand,
  .sl-zen-icon--compress {
    position: absolute;
    inset: 0;
    transform-origin: center;
  }
  .sl-zen-icon--compress {
    opacity: 0;
    transform: scale(0.5);
  }
  :global(html[data-zen-mode="true"]) .sl-zen-icon--expand {
    opacity: 0;
  }
  :global(html[data-zen-mode="true"]) .sl-zen-icon--compress {
    opacity: 1;
    transform: scale(1);
  }
  .sl-zen-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--sl-color-gray-3);
    opacity: 0.45;
    transition: background-color 180ms ease, opacity 180ms ease;
  }
  :global(html[data-zen-mode="true"]) .sl-zen-dot {
    background: var(--sl-color-accent-high);
    opacity: 1;
  }
</style>

<style is:global>
  main img:not([class*="avatar"]):not(.sl-blog-author-image) {
    max-height: 440px !important;
    max-width: 100% !important;
    width: auto !important;
    object-fit: contain !important;
    display: block !important;
    margin: 2rem auto !important;
    border-radius: 8px;
  }
  @media (max-width: 50rem) {
    .hero > img {
      max-height: 150px !important;
      margin: 0.25rem auto 0.75rem !important;
    }
  }
</style>

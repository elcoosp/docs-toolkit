---
import type { Props } from '@astrojs/starlight/types';
import * as si from 'simple-icons';

const { editUrl } = Astro.props;
const isFr = Astro.currentLocale === 'fr' || Astro.url.pathname === '/fr' || Astro.url.pathname.startsWith('/fr/');
const pagePath = Astro.url.pathname;
const pageUrl = Astro.site ? new URL(pagePath, Astro.site).toString() : pagePath;
const aiPrompt = encodeURIComponent(`Read and summarize this documentation: ${pageUrl}`);

const openaiPath = 'M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.476 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z';
const pickIcon = (key: string, fallback: string): string => (si as any)[key]?.path ?? fallback;

const aiProviders = [
  { name: 'ChatGPT', href: 'https://chatgpt.com' + aiPrompt, path: openaiPath },
  { name: 'Claude', href: 'https://claude.ai' + aiPrompt, path: pickIcon('siClaude', openaiPath) },
  { name: 'Gemini', href: 'https://google.com' + aiPrompt, path: pickIcon('siGooglegemini', openaiPath) },
  { name: 'Perplexity', href: 'https://perplexity.ai' + aiPrompt, path: pickIcon('siPerplexity', openaiPath) },
  { name: 'Grok', href: 'https://grok.com' + aiPrompt, path: pickIcon('siX', openaiPath) },
  { name: 'Mistral Le Chat', href: 'https://mistral.ai' + aiPrompt, path: pickIcon('siMistralai', openaiPath) },
  { name: 'DeepSeek', href: 'https://deepseek.com' + aiPrompt, path: pickIcon('siDeepseek', openaiPath) },
  { name: 'Qwen', href: 'https://qwen.ai' + aiPrompt, path: pickIcon('siQwen', openaiPath) },
  { name: 'GitHub Copilot', href: 'https://github.com' + aiPrompt, path: pickIcon('siGithubcopilot', openaiPath) },
  { name: 'HuggingChat', href: 'https://huggingface.co' + aiPrompt, path: pickIcon('siHuggingface', openaiPath) },
  { name: 'Meta AI', href: 'https://meta.ai' + aiPrompt, path: pickIcon('siMeta', openaiPath) },
  { name: 'Duck.ai', href: 'https://duck.ai' + aiPrompt, path: pickIcon('siDuckduckgo', openaiPath) },
];

const labels = isFr
  ? {
      copy: 'Copier en Markdown',
      copyTitle: 'Copier la page au format Markdown',
      copied: 'Copié !',
      copyError: 'Impossible de copier le Markdown pour cette page.',
      openAi: "Ouvrir dans l'IA",
      share: 'Partager',
      shareTitle: 'Partager cette page',
      linkCopied: 'Lien copié dans le presse-papiers !',
      source: 'Source',
      sourceTitle: 'Voir la source sur GitHub',
    }
  : {
      copy: 'Copy Markdown',
      copyTitle: 'Copy page as Markdown',
      copied: 'Copied!',
      copyError: 'Failed to copy Markdown for this page.',
      openAi: 'Open in AI',
      share: 'Share',
      shareTitle: 'Share this page',
      linkCopied: 'Link copied to clipboard!',
      source: 'Source',
      sourceTitle: 'View source on GitHub',
    };
---

<div class="page-actions-container not-content" data-copied-label={labels.copied} data-copy-error={labels.copyError} data-link-copied={labels.linkCopied}>
  <button id="copy-markdown" type="button" class="action-btn" title={labels.copyTitle}>
    <svg xmlns="http://w3.org" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
    <span>{labels.copy}</span>
  </button>

  <div class="action-dropdown">
    <button type="button" class="action-btn" aria-haspopup="true">
      <svg xmlns="http://w3.org" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/></svg>
      <span>{labels.openAi}</span>
      <svg xmlns="http://w3.org" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
    </button>
    <div class="dropdown-bridge">
      <div class="dropdown-menu" role="menu">
        {aiProviders.map((provider) => (
          <a role="menuitem" href={provider.href} target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={provider.path} /></svg>
            <span>{provider.name}</span>
          </a>
        ))}
      </div>
    </div>
  </div>

  <button id="share-page" type="button" class="action-btn" title={labels.shareTitle}>
    <svg xmlns="http://w3.org" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/><line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/></svg>
    <span>{labels.share}</span>
  </button>

  {editUrl && (
    <a href={editUrl} target="_blank" rel="noopener" class="action-btn" title={labels.sourceTitle}>
      <svg xmlns="http://w3.org" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/><path d="m15 5 4 4"/></svg>
      <span>{labels.source}</span>
    </a>
  )}
</div>

<script>
  function resolveMarkdownUrl(pathname) {
    const clean = pathname.replace(/\/+$/, '');
    if (clean === '') return '/index.md';
    if (clean === '/fr') return '/fr/index.md';
    return clean + '.md';
  }

  const container = document.querySelector('.page-actions-container');
  const copiedLabel = container?.getAttribute('data-copied-label') ?? 'Copied!';
  const copyError = container?.getAttribute('data-copy-error') ?? 'Failed to copy Markdown.';
  const linkCopied = container?.getAttribute('data-link-copied') ?? 'Link copied to clipboard!';

  document.getElementById('copy-markdown')?.addEventListener('click', async () => {
    const mdUrl = resolveMarkdownUrl(window.location.pathname);
    try {
      const res = await fetch(mdUrl);
      if (!res.ok) throw new Error('Not found');
      const text = await res.text();
      await navigator.clipboard.writeText(text);

      const btn = document.getElementById('copy-markdown');
      if (btn) {
        const originalHtml = btn.innerHTML;
        btn.textContent = '✓ ' + copiedLabel;
        setTimeout(() => {
          btn.innerHTML = originalHtml;
        }, 2000);
      }
    } catch {
      alert(copyError);
    }
  });

  document.getElementById('share-page')?.addEventListener('click', async () => {
    if (navigator.share) {
      await navigator.share({ title: document.title, url: window.location.href });
    } else {
      await navigator.clipboard.writeText(window.location.href);
      alert(linkCopied);
    }
  });
</script>

<style>
  .page-actions-container {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .action-btn {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    padding: 0.32rem 0.7rem;
    border-radius: 0.45rem;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .action-btn:hover,
  .action-btn:focus-visible {
    background: var(--sl-color-bg-sidebar);
    border-color: var(--sl-color-accent);
  }
  .action-dropdown {
    position: relative;
    display: inline-block;
  }
  .dropdown-bridge {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    padding-top: 0.25rem;
    z-index: 20;
    min-width: 175px;
  }
  .action-dropdown:hover .dropdown-bridge,
  .action-dropdown:focus-within .dropdown-bridge {
    display: block;
  }
  .dropdown-menu {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.45rem;
    box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    max-height: 320px;
    overflow-y: auto;
  }
  .dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.8rem;
    text-decoration: none;
    color: var(--sl-color-text);
    font-size: 0.82rem;
    white-space: nowrap;
  }
  .dropdown-menu a svg {
    flex-shrink: 0;
  }
  .dropdown-menu a:hover,
  .dropdown-menu a:focus-visible {
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-text-accent);
  }
</style>

<style is:global>
  main img:not([class*="avatar"]):not(.sl-blog-author-image) {
    max-height: 440px !important;
    max-width: 100% !important;
    width: auto !important;
    object-fit: contain !important;
    display: block !important;
    margin: 2rem auto !important;
    border-radius: 8px;
  }
</style>

---
type Props = Record<string, any>;
import * as si from 'simple-icons';

const { editUrl } = Astro.props;
const isFr = Astro.currentLocale === 'fr' || Astro.url.pathname === '/fr' || Astro.url.pathname.startsWith('/fr/');
const pagePath = Astro.url.pathname;
const pageUrl = Astro.site ? new URL(pagePath, Astro.site).toString() : pagePath;
const aiPrompt = encodeURIComponent(`Read and summarize this documentation: ${pageUrl}`);

const openaiPath = 'M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.985 5.985 0 0 0-3.998 2.9 6.046 6.046 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.476 4.476 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z';
const pickIcon = (key: string, fallback: string): string => (si as any)[key]?.path ?? fallback;

const aiProviders = [
  { name: 'ChatGPT', tag: 'OpenAI', href: 'https://chatgpt.com' + aiPrompt, path: openaiPath },
  { name: 'Claude', tag: 'Anthropic', href: 'https://claude.ai' + aiPrompt, path: pickIcon('siClaude', openaiPath) },
  { name: 'Gemini', tag: 'Google', href: 'https://google.com' + aiPrompt, path: pickIcon('siGooglegemini', openaiPath) },
  { name: 'Perplexity', tag: 'Search', href: 'https://perplexity.ai' + aiPrompt, path: pickIcon('siPerplexity', openaiPath) },
  { name: 'Grok', tag: 'xAI', href: 'https://grok.com' + aiPrompt, path: pickIcon('siX', openaiPath) },
  { name: 'Le Chat', tag: 'Mistral', href: 'https://mistral.ai' + aiPrompt, path: pickIcon('siMistralai', openaiPath) },
  { name: 'DeepSeek', tag: 'Reasoning', href: 'https://deepseek.com' + aiPrompt, path: pickIcon('siDeepseek', openaiPath) },
  { name: 'Qwen', tag: 'Alibaba', href: 'https://qwen.ai' + aiPrompt, path: pickIcon('siQwen', openaiPath) },
  { name: 'Copilot', tag: 'Microsoft', href: 'https://microsoft.com' + aiPrompt, path: pickIcon('siGithubcopilot', openaiPath) },
  { name: 'HuggingChat', tag: 'Open Models', href: 'https://huggingface.co' + aiPrompt, path: pickIcon('siHuggingface', openaiPath) },
  { name: 'Meta AI', tag: 'Llama', href: 'https://meta.ai' + aiPrompt, path: pickIcon('siMeta', openaiPath) },
  { name: 'Duck.ai', tag: 'Private', href: 'https://duck.ai' + aiPrompt, path: pickIcon('siDuckduckgo', openaiPath) },
];

const labels = isFr
  ? {
      copy: 'Copier',
      copyTitle: 'Copier la page au format Markdown',
      copied: 'Copié',
      copyError: 'Échec de copie',
      openAi: "Ouvrir dans l'IA",
      aiHeader: 'Continuer avec un assistant IA',
      share: 'Partager',
      shareTitle: 'Partager cette page',
      linkCopied: 'Copié',
      source: 'Source',
      sourceTitle: 'Voir la source sur GitHub',
    }
  : {
      copy: 'Copy',
      copyTitle: 'Copy page as Markdown',
      copied: 'Copied',
      copyError: 'Copy failed',
      openAi: 'Open in AI',
      aiHeader: 'Ask an AI assistant about this page',
      share: 'Share',
      shareTitle: 'Share this page',
      linkCopied: 'Copied',
      source: 'Source',
      sourceTitle: 'View source on GitHub',
    };
---

<div
  class="page-actions-container not-content"
  data-copy-label={labels.copy}
  data-copied-label={labels.copied}
  data-copy-error={labels.copyError}
  data-share-label={labels.share}
  data-link-copied={labels.linkCopied}
>
  <button id="copy-markdown" type="button" class="action-btn action-btn--morph" title={labels.copyTitle}>
    <span class="morph-icon" aria-hidden="true">
      <svg class="morph-icon__base" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="14" height="14" x="8" y="8" rx="2" ry="2" />
        <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" />
      </svg>
      <svg class="morph-icon__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 12.75l5.25 5.25L19.5 7.5" />
      </svg>
    </span>
    <span class="morph-label"><span class="morph-label__default">{labels.copy}</span><span class="morph-label__success" aria-hidden="true">{labels.copied}</span></span>
  </button>

  <div class="action-dropdown" data-open="false">
    <button id="open-ai-trigger" type="button" class="action-btn" aria-haspopup="menu" aria-expanded="false">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 8V4H8" />
        <rect width="16" height="12" x="4" y="8" rx="2" />
        <path d="M2 14h2" />
        <path d="M20 14h2" />
        <path d="M15 13v2" />
        <path d="M9 13v2" />
      </svg>
      <span>{labels.openAi}</span>
      <svg class="ai-chevron" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="m6 9 6 6 6-6" />
      </svg>
    </button>
    <div class="dropdown-bridge">
      <div class="dropdown-menu" role="menu">
        <div class="dropdown-menu__header">
          <span>{labels.aiHeader}</span>
        </div>
        <div class="dropdown-menu__grid">
          {aiProviders.map((provider) => (
            <a class="ai-card" role="menuitem" href={provider.href} target="_blank" rel="noopener">
              <span class="ai-card__icon">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d={provider.path} />
                </svg>
              </span>
              <span class="ai-card__text">
                <span class="ai-card__name">{provider.name}</span>
                <span class="ai-card__tag">{provider.tag}</span>
              </span>
              <svg class="ai-card__arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M7 17 17 7" />
                <path d="M7 7h10v10" />
              </svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <button id="share-page" type="button" class="action-btn action-btn--morph" title={labels.shareTitle}>
    <span class="morph-icon" aria-hidden="true">
      <svg class="morph-icon__base" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="18" cy="5" r="3" />
        <circle cx="6" cy="12" r="3" />
        <circle cx="18" cy="19" r="3" />
        <line x1="8.59" x2="15.42" y1="13.51" y2="17.49" />
        <line x1="15.41" x2="8.59" y1="6.51" y2="10.49" />
      </svg>
      <svg class="morph-icon__check" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4.5 12.75l5.25 5.25L19.5 7.5" />
      </svg>
    </span>
    <span class="morph-label"><span class="morph-label__default">{labels.share}</span><span class="morph-label__success" aria-hidden="true">{labels.linkCopied}</span></span>
  </button>

  {editUrl && (
    <a href={editUrl} target="_blank" rel="noopener" class="action-btn" title={labels.sourceTitle}>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
        <path d="m15 5 4 4" />
      </svg>
      <span>{labels.source}</span>
    </a>
  )}
</div>

<script>
  import './page-actions-client.ts';
</script>

<style>
  .page-actions-container {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.75rem;
    margin-bottom: 0.25rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .action-btn {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    padding: 0.34rem 0.72rem;
    border-radius: 0.5rem;
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.3;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    transition: border-color 150ms ease, background-color 150ms ease, color 150ms ease;
  }
  .action-btn:hover,
  .action-btn:focus-visible {
    background: var(--sl-color-bg-sidebar);
    border-color: var(--sl-color-accent);
  }
  .action-btn:active {
    transform: scale(0.97);
  }
  .action-btn[data-state='success'] {
    border-color: color-mix(in srgb, #10b981 55%, var(--sl-color-hairline));
    background: color-mix(in srgb, #10b981 12%, var(--sl-color-bg-nav));
    color: #059669;
  }
  :root[data-theme='dark'] .action-btn[data-state='success'] {
    color: #34d399;
  }
  .morph-icon {
    position: relative;
    display: inline-flex;
align-items: center;
justify-content: center;
width: 15px;
height: 15px;
flex-shrink: 0;
}
.morph-icon__base,
.morph-icon__check {
position: absolute;
inset: 0;
transform-origin: center;
}
.morph-icon__check {
opacity: 0;
transform: scale(0.5);
}
.morph-label {
display: inline-grid;
align-items: center;
}
.morph-label__default,
.morph-label__success {
grid-area: 1 / 1;
transition: opacity 150ms ease;
}
.morph-label__success {
opacity: 0;
}
.action-btn[data-state='success'] .morph-label__default {
opacity: 0;
}
.action-btn[data-state='success'] .morph-label__success {
opacity: 1;
}
.action-dropdown {
position: relative;
display: inline-block;
}
.action-dropdown[data-open='true'] > .action-btn {
border-color: var(--sl-color-accent);
background: var(--sl-color-bg-sidebar);
}
.dropdown-bridge {
display: none;
position: absolute;
top: 100%;
left: 0;
padding-top: 0.35rem;
z-index: 40;
}
.action-dropdown[data-open='true'] .dropdown-bridge {
display: block;
}
.dropdown-menu {
width: min(372px, calc(100vw - 2rem));
padding: 0.55rem;
background: var(--sl-color-bg-nav);
border: 1px solid var(--sl-color-hairline);
border-radius: 0.75rem;
box-shadow:
0 18px 40px -10px rgba(0, 0, 0, 0.28),
0 4px 12px -2px rgba(0, 0, 0, 0.12);
transform-origin: top left;
}
:root[data-theme='dark'] .dropdown-menu {
box-shadow:
0 20px 44px -10px rgba(0, 0, 0, 0.62),
0 4px 14px -2px rgba(0, 0, 0, 0.35);
}
.dropdown-menu__header {
padding: 0.15rem 0.35rem 0.45rem;
font-size: 0.7rem;
font-weight: 600;
letter-spacing: 0.03em;
text-transform: uppercase;
color: var(--sl-color-gray-3);
}
.dropdown-menu__grid {
display: grid;
grid-template-columns: repeat(2, minmax(0, 1fr));
gap: 0.3rem;
}
@media (max-width: 420px) {
.dropdown-menu__grid {
grid-template-columns: 1fr;
}
}
.ai-card {
display: flex;
align-items: center;
gap: 0.5rem;
padding: 0.42rem 0.5rem;
border-radius: 0.5rem;
border: 1px solid transparent;
text-decoration: none;
color: var(--sl-color-text);
transition: background-color 140ms ease, border-color 140ms ease;
}
.ai-card:hover,
.ai-card:focus-visible {
background: var(--sl-color-bg-sidebar);
border-color: color-mix(in srgb, var(--sl-color-accent) 42%, transparent);
outline: none;
}
.ai-card__icon {
display: inline-flex;
align-items: center;
justify-content: center;
width: 26px;
height: 26px;
border-radius: 0.42rem;
background: var(--sl-color-bg-inline-code, rgba(128, 128, 128, 0.1));
border: 1px solid var(--sl-color-hairline-light, rgba(128, 128, 128, 0.18));
color: var(--sl-color-text);
flex-shrink: 0;
transition: background-color 140ms ease, color 140ms ease, border-color 140ms ease;
}
.ai-card:hover .ai-card__icon {
background: var(--sl-color-accent-low);
border-color: color-mix(in srgb, var(--sl-color-accent) 36%, transparent);
color: var(--sl-color-accent-high);
}
.ai-card__text {
display: flex;
flex-direction: column;
min-width: 0;
flex: 1;
line-height: 1.2;
}
.ai-card__name {
font-size: 0.79rem;
font-weight: 600;
color: var(--sl-color-text);
white-space: nowrap;
overflow: hidden;
text-overflow: ellipsis;
}
.ai-card__tag {
font-size: 0.67rem;
color: var(--sl-color-gray-3);
margin-top: 0.1rem;
}
.ai-card__arrow {
opacity: 0;
color: var(--sl-color-accent-high);
flex-shrink: 0;
transform: translate(-3px, 3px);
transition: opacity 140ms ease, transform 160ms cubic-bezier(0.22, 1, 0.36, 1);
}
.ai-card:hover .ai-card__arrow,
.ai-card:focus-visible .ai-card__arrow {
opacity: 0.9;
transform: translate(0, 0);
}
</style>

<style is:global>
  main img:not([class*="avatar"]):not(.sl-blog-author-image) {
max-height: 440px !important;
max-width: 100% !important;
width: auto !important;
object-fit: contain !important;
display: block !important;
margin: 2rem auto !important;
border-radius: 8px;
}
</style>

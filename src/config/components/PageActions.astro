---
import type { Props } from '@astrojs/starlight/props';
const { editUrl } = Astro.props;
const pagePath = Astro.url.pathname;
const markdownPath = pagePath.replace(/\/$/, '') + '.md';
const pageUrl = Astro.site ? new URL(pagePath, Astro.site).toString() : pagePath;
---

<div class="page-actions-container">
  <button id="copy-markdown" class="action-btn" title="Copy page as Markdown">
    📋 Copy Markdown
  </button>

  <div class="action-dropdown">
    <button class="action-btn">🤖 Open in AI</button>
    <div class="dropdown-menu">
      <a href={`https://chatgpt.com/?q=Summarize+this+documentation:+${pageUrl}`} target="_blank" rel="noopener">ChatGPT</a>
      <a href={`https://claude.ai/new?q=Summarize+this+documentation:+${pageUrl}`} target="_blank" rel="noopener">Claude</a>
      <a href={`https://gemini.google.com/app?q=Summarize+this+documentation:+${pageUrl}`} target="_blank" rel="noopener">Gemini</a>
    </div>
  </div>

  <button id="share-page" class="action-btn" title="Share this page">
    🔗 Share
  </button>

  {editUrl && (
    <a href={editUrl} target="_blank" rel="noopener" class="action-btn" title="View source">
      ✏️ Source
    </a>
  )}
</div>

<script>
  // Copy Markdown logic (uses the .md twins generated by the llms integration)
  document.getElementById('copy-markdown')?.addEventListener('click', async () => {
    const mdUrl = window.location.pathname.replace(/\/$/, '') + '.md';
    try {
      const res = await fetch(mdUrl);
      if (!res.ok) throw new Error('Not found');
      const text = await res.text();
      await navigator.clipboard.writeText(text);

      const btn = document.getElementById('copy-markdown');
      if (btn) {
        const originalText = btn.innerHTML;
        btn.innerHTML = '✅ Copied!';
        setTimeout(() => btn.innerHTML = originalText, 2000);
      }
    } catch (e) {
      alert('Failed to copy Markdown. The .md twin might not exist for this page.');
    }
  });

  // Native Share logic
  document.getElementById('share-page')?.addEventListener('click', async () => {
    if (navigator.share) {
      await navigator.share({
        title: document.title,
        url: window.location.href
      });
    } else {
      await navigator.clipboard.writeText(window.location.href);
      alert('Link copied to clipboard!');
    }
  });
</script>

<style>
  .page-actions-container {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .action-btn {
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    color: var(--sl-color-text);
    padding: 0.4rem 0.8rem;
    border-radius: 0.4rem;
    font-size: 0.85rem;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    transition: all 0.2s;
  }
  .action-btn:hover {
    background: var(--sl-color-bg-sidebar);
    border-color: var(--sl-color-accent);
  }
  .action-dropdown {
    position: relative;
    display: inline-block;
  }
  .dropdown-menu {
    display: none;
    position: absolute;
    background: var(--sl-color-bg-nav);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.4rem;
    top: 100%;
    left: 0;
    margin-top: 0.2rem;
    z-index: 10;
    flex-direction: column;
    min-width: 120px;
  }
  .dropdown-menu a {
    padding: 0.4rem 0.8rem;
    text-decoration: none;
    color: var(--sl-color-text);
    font-size: 0.85rem;
  }
  .dropdown-menu a:hover {
    background: var(--sl-color-bg-sidebar);
  }
  .action-dropdown:hover .dropdown-menu {
    display: flex;
  }
</style>

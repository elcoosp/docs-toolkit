---
import { Icon } from '@astrojs/starlight/components';
import type { StarlightIcon } from '@astrojs/starlight/types';
import type { DiataxisItem } from './index';

interface Props {
  items?: DiataxisItem[];
  stagger?: boolean;
}

const ICONS: Record<DiataxisItem['quadrant'], StarlightIcon> = {
  tutorials: 'rocket',
  'how-to': 'puzzle',
  reference: 'open-book',
  explanation: 'information',
};

const t = (Astro.locals as any).t as ((k: string) => string) | undefined;
const tr = (key: string, fallback: string): string => {
  try {
    const val = t?.(key);
    return val && val !== key ? val : fallback;
  } catch {
    return fallback;
  }
};

const isFr = Astro.currentLocale?.startsWith('fr') || Astro.url.pathname.startsWith('/fr');
const p = isFr ? '/fr' : '';

const DEFAULTS: DiataxisItem[] = [
  { quadrant: 'tutorials', title: tr('diataxis.tutorials', 'Tutorials'), description: tr('diataxis.tutorialsDesc', 'Follow a step-by-step walkthrough from installation to a working project.'), href: `${p}/tutorials/` },
  { quadrant: 'how-to', title: tr('diataxis.howTo', 'How-to Guides'), description: tr('diataxis.howToDesc', 'Solve specific tasks with focused, practical recipes and configuration patterns.'), href: `${p}/guides/` },
  { quadrant: 'reference', title: tr('diataxis.reference', 'Reference'), description: tr('diataxis.referenceDesc', 'Look up exact APIs, types, CLI flags, configuration keys, and error codes.'), href: `${p}/reference/` },
  { quadrant: 'explanation', title: tr('diataxis.explanation', 'Explanation'), description: tr('diataxis.explanationDesc', 'Understand the architecture, design trade-offs, and mental model under the hood.'), href: `${p}/explanation/` },
];

const { items = DEFAULTS, stagger = true } = Astro.props;
---

<div class:list={['dt-diataxis not-content', { 'dt-stagger': stagger }]}>
  {items.map((item) => (
    <a class="dt-card" href={item.href}>
      <div class="dt-card-head">
        <span class="dt-icon" aria-hidden="true"><Icon name={ICONS[item.quadrant] ?? 'rocket'} size="1.15rem" /></span>
        <h3 class="dt-title">
          <span>{item.title}</span>
          {item.badge && <span class="dt-badge">{item.badge}</span>}
          <span class="dt-arrow" aria-hidden="true">→</span>
        </h3>
      </div>
      <p class="dt-desc">{item.description}</p>
    </a>
  ))}
</div>

<style>
  .dt-diataxis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-block: 1.5rem 2.25rem; }
  @media (max-width: 44rem) { .dt-diataxis { grid-template-columns: 1fr; } }
  @media (min-width: 50rem) { .dt-stagger > :nth-child(2n) { transform: translateY(0.65rem); } .dt-stagger { padding-bottom: 0.65rem; } }
  .dt-card { display: flex; flex-direction: column; gap: 0.65rem; padding: 1.25rem 1.35rem; border-radius: 0.85rem; border: 1px solid var(--sl-color-hairline-shade, var(--sl-color-gray-5)); background: color-mix(in srgb, var(--sl-color-bg-nav) 65%, var(--sl-color-bg)); text-decoration: none !important; color: inherit; transition: transform 0.18s ease, border-color 0.18s ease, background-color 0.18s ease; }
  .dt-card:hover, .dt-card:focus-visible { transform: translateY(-2px); border-color: var(--sl-color-accent); background: color-mix(in srgb, var(--sl-color-accent-low) 28%, var(--sl-color-bg)); }
  .dt-card-head { display: flex; align-items: center; gap: 0.75rem; }
  .dt-icon { display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; width: 2.15rem; height: 2.15rem; border-radius: 0.55rem; background: color-mix(in srgb, var(--sl-color-accent-low) 55%, transparent); color: var(--sl-color-text-accent); }
  .dt-title { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; flex: 1; margin: 0 !important; font-size: 1.02rem; font-weight: 650; line-height: 1.3; color: var(--sl-color-white); }
  .dt-badge { font-size: 0.68rem; font-weight: 600; padding: 0.12rem 0.45rem; border-radius: 999px; background: color-mix(in srgb, var(--sl-color-accent) 14%, transparent); color: var(--sl-color-text-accent); }
  .dt-arrow { color: var(--sl-color-gray-3); transition: transform 0.18s ease, color 0.18s ease; }
  .dt-card:hover .dt-arrow { transform: translateX(3px); color: var(--sl-color-text-accent); }
  .dt-desc { margin: 0 !important; font-size: 0.91rem; line-height: 1.58; color: var(--sl-color-gray-2); }
</style>

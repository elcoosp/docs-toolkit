{
  "name": "@elcoosp/docs-toolkit",
  "version": "0.6.1",
  "description": "Shared OG image generation, docs config helper, and QA tooling for Starlight sites",
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./og": {
      "types": "./dist/og/index.d.mts",
      "import": "./dist/og/index.mjs"
    },
    "./og/routeData": {
      "types": "./dist/og/routeData.d.mts",
      "import": "./dist/og/routeData.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./PageActions.astro": "./src/config/components/PageActions.astro"
  },
  "bin": {
    "docs-toolkit-qa-components": "./dist/qa/components.mjs",
    "docs-toolkit-qa-screenshots": "./dist/qa/screenshots.mjs",
    "docs-toolkit-bootstrap-artifacts": "./dist/qa/bootstrap-artifacts.mjs"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "i18n"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/prebuild.ts && tsdown && node scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/prebuild.ts",
    "prepublishOnly": "node scripts/prebuild.ts && tsdown && node scripts/postbuild.ts && pnpm check:dist",
    "check:dist": "! grep -rlE \"from ['\\\"]starlight-(blog|giscus)\" dist/*.mjs | grep -v '^dist/config-' || (echo 'FAIL: eager static import of starlight-(blog|giscus) in dist (excluding config-*.mjs)' && exit 1)"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@d2lang/d2": "^0.1.34",
    "@elcoosp/astro-takumi": "^2.1.1",
    "astro-d2": "^0.14.1",
    "astro-mermaid": "^2.2.0",
    "github-slugger": "^2.0.0",
    "linkedom": "^0.18.15",
    "marked": "^15.0.7",
    "sharp": "^0.35.5",
    "starlight-announcement": "^2.0.0",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-blog": "^0.30.2",
    "starlight-changelogs": "^0.7.1",
    "starlight-giscus": "^1.2.0",
    "starlight-heading-badges": "*",
    "starlight-image-zoom": "^0.16.2",
    "starlight-scroll-to-top": "^2.0.0",
    "starlight-seo": "^1.0.0",
    "starlight-telescope": "^2.0.0",
    "starlight-view-modes": "^0.15.4",
    "tsx": "^4.19.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "expressive-code-collapsible": "^1.1.0",
    "mermaid": "^11.0.0",
    "starlight-fullview-mode": "^0.2.6",
    "starlight-tags": "^2.0.0",
    "tsdown": "^0.23.7",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.0.0",
    "mermaid": "^11.0.0",
    "playwright": "^1.65.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/docs-toolkit.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}

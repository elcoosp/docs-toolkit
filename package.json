{
  "name": "@elcoosp/docs-toolkit",
  "version": "1.8.0",
  "description": "Shared OG image generation, docs config helper, and QA tooling for Starlight sites",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elcoosp/docs-toolkit.git"
  },
  "bin": {
    "docs-toolkit-qa-components": "dist/qa/components.mjs",
    "docs-toolkit-qa-screenshots": "dist/qa/screenshots.mjs",
    "docs-toolkit-bootstrap-artifacts": "dist/qa/bootstrap-artifacts.mjs",
    "docs-toolkit-lint": "dist/qa/lint.mjs"
  },
  "files": [
    "dist",
    "assets",
    "src",
    "README.md",
    "i18n",
    "tsconfig.base.json",
    "ec.config.mjs",
    "rumdl.toml",
    ".oxlintrc.json",
    ".oxfmtrc.json",
    "mdsf.json"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./og": {
      "types": "./dist/og/index.d.mts",
      "import": "./dist/og/index.mjs"
    },
    "./og/routeData": {
      "types": "./dist/og/routeData.d.mts",
      "import": "./dist/og/routeData.mjs"
    },
    "./config": {
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config/index.mjs"
    },
    "./collections": {
      "types": "./dist/config/collections.d.mts",
      "import": "./dist/config/collections.mjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*",
    "./PageActions.astro": "./src/config/components/PageActions.astro",
    "./components": "./src/components/index.ts",
    "./tsconfig.base.json": "./tsconfig.base.json",
    "./rumdl.toml": "./rumdl.toml",
    "./mdsf.json": "./mdsf.json",
    "./plugins/link-preview": {
      "types": "./dist/plugins/link-preview/index.d.mts",
      "import": "./dist/plugins/link-preview/index.mjs"
    },
    "./plugins/reading-context": {
      "types": "./dist/plugins/reading-context/index.d.mts",
      "import": "./dist/plugins/reading-context/index.mjs"
    },
    "./ec.config": "./ec.config.mjs"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/prebuild.ts && tsdown && node scripts/postbuild.ts",
    "typecheck": "tsc --noEmit",
    "prebuild": "node scripts/prebuild.ts",
    "prepublishOnly": "node scripts/prebuild.ts && tsdown && node scripts/postbuild.ts && pnpm check:dist",
    "check:dist": "! grep -rlE \"from ['\\\"]starlight-(blog|giscus)\" dist/*.mjs | grep -vE '^dist/(config|collections)-' || (echo 'FAIL: eager static import of starlight-(blog|giscus) in dist (excluding config-*.mjs)' && exit 1)",
    "lint": "oxlint -c .oxlintrc.json --deny-warnings",
    "lint:fix": "oxlint -c .oxlintrc.json --fix",
    "fmt": "oxfmt -c .oxfmtrc.json",
    "fmt:check": "oxfmt -c .oxfmtrc.json --check",
    "test": "vitest run",
    "test:unit": "vitest run --project unit-linkedom",
    "test:browser": "vitest run --project browser-dom",
    "test:e2e": "vitest run --project e2e-real-site",
    "test:cov": "vitest run --coverage",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@elcoosp/astro-takumi": "^2.2.0",
    "@expressive-code/plugin-line-numbers": "^0.44.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "expressive-code-collapsible": "^1.1.0",
    "linkedom": "^0.18.15",
    "motion": "^14.14.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.94.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rumdl": "^0.3.4",
    "sharp": "^0.35.5",
    "simple-icons": "^16.38.0",
    "starlight-announcement": "^2.0.0",
    "starlight-auto-drafts": "^0.3.1",
    "starlight-auto-sidebar": "^0.4.1",
    "starlight-blog": "^0.30.2",
    "starlight-changelogs": "^0.7.2",
    "starlight-codeblock-fullscreen": "^2.0.0",
    "starlight-giscus": "^1.2.0",
    "starlight-github-alerts": "^0.5.0",
    "starlight-heading-badges": "^0.8.0",
    "starlight-image-zoom": "^0.16.3",
    "starlight-kbd": "^0.4.0",
    "starlight-links-validator": "^0.27.0",
    "starlight-package-managers": "^0.13.1",
    "starlight-scroll-to-top": "^2.0.0",
    "starlight-seo": "^1.0.0",
    "starlight-sidebar-topics": "^0.9.0",
    "starlight-telescope": "^2.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "expressive-code-collapsible": "^1.1.0",
    "starlight-auto-drafts": "^0.3.1",
    "starlight-codeblock-fullscreen": "^2.0.0",
    "starlight-package-managers": "^0.13.1",
    "starlight-sidebar-topics": "^0.9.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13",
    "playwright": "^1.65.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
